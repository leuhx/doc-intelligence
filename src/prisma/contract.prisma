// use prisma-next
enum DocumentStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum AttributeDataType {
  STRING
  NUMBER
  DATE
  BOOLEAN
}

model DocumentType {
  id          String              @id @default(uuid())
  name        String
  description String?
  documents   Document[]
  attributes  DocumentAttribute[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("document_types")
}

model DocumentAttribute {
  id          String             @id @default(uuid())
  documentTypeId String
  documentType   DocumentType    @relation(
    fields: [documentTypeId],
    references: [id]
  )
  key         String
  label       String
  dataType    AttributeDataType
  required    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([documentTypeId, key])
  @@map("document_attributes")
}

model Document {
  id            String         @id @default(uuid())
  documentTypeId String?
  documentType   DocumentType? @relation(
    fields: [documentTypeId],
    references: [id]
  )
  fileName      String
  fileUrl       String
  mimeType      String
  status        DocumentStatus  @default(PENDING)
  extractedData Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([documentTypeId])
  @@index([status])
  @@map("documents")
}
